{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "BasculaAgent": {
    "SerialPort": {
      "PortName": "COM3",
      "BaudRate": 9600
    },
    "Mqtt": {
      "Host": "localhost",
      "Port": 1883,
      "Topic": "wms/basculas/estacion1"
    },
    "Polling": {
      "Command": "P",
      "IntervalSeconds": 1,
      "ReadDelayMs": 300,
      "ReconnectDelaySeconds": 5
    },
    "Unidades": {
      "UnidadesAceptadas": [ "Kilos" ]
    }
  }
}
