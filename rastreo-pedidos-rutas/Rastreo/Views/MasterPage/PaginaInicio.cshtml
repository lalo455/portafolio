                                                <td class="text-center" ng-click="AbrirModalEstadoPedido(pedido.NoPedido, 'Carlos')">{{pedido.DocDate}}</td>
                                                <td class="text-center" ng-click="AbrirModalEstadoPedido(pedido.NoPedido, 'Carlos')">{{pedido.DocDueDate}}</td>
                                                <td class="text-center" ng-click="AbrirModalEstadoPedido(pedido.NoPedido, 'Carlos')">{{pedido.ItemCode}}</td>
                                                <td class="text-center" ng-click="AbrirModalEstadoPedido(pedido.NoPedido, 'Carlos')">{{pedido.ItemName}}</td>
                                                <td class="text-center" ng-click="AbrirModalEstadoPedido(pedido.NoPedido, 'Carlos')">{{pedido.QtyPedida}}</td>
                                                <td class="text-center" ng-click="AbrirModalEstadoPedido(pedido.NoPedido, 'Carlos')">{{pedido.QtyPendiente}}</td>
