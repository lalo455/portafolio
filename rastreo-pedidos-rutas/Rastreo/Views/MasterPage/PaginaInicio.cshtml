                                                    <button type="button" class="btn btn-default" ng-click="ConsultaPedidos();">
                                                        <img src="~/Images/search1.png" /> <span><strong>Buscar</strong></span>
                                                    </button>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>

