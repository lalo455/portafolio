                                                <a href="#"
                                                   editable-select="TipoConsulta.Tipo"
                                                   buttons="no"
                                                   e-ng-options="s.value as s.text for s in ListaTipoConsulta"
                                                   class="form-control inputstl">
                                                    {{VisualizarTipoConsulta()}}
                                                </a>
                                            </div>
                                            <div class="col-lg-2 col-md-2 col-sm-4 col-xs-4" ng-show="TipoConsulta.Tipo != 'Todos'">
                                                <label>{{TipoConsulta.Tipo == 'Fecha' ? 'Desde' : TipoConsulta.Tipo == 'DocNum' ? 'No. Docto' : TipoConsulta.Tipo == 'Articulo' ? 'Código de Articulo' : '' }}</label>
                                            </div>
                                            <div id="tipoConsulta" class="col-lg-4 col-md-4 col-sm-4 col-xs-4" ng-show="TipoConsulta.Tipo != 'Todos'">
                                                <a class="form-control inputstl"
                                                   ng-show="TipoConsulta.Tipo == 'Fecha'"
                                                   name="fechaConsulta" href="#"
                                                   editable-date="ValorConsulta"
                                                   buttons="yes"
                                                   onaftersave="">{{ ValorConsulta | date: "yyyy-MM-dd"}}</a>
                                                <a class="form-control inputstl"
                                                   ng-show="TipoConsulta.Tipo == 'DocNum'"
                                                   name="fechaConsulta" href="#"
                                                   buttons="yes"
                                                   editable-number="ValorConsulta"
                                                   onaftersave="">{{ ValorConsulta}}</a>
                                                <a class="form-control inputstl"
                                                   ng-show="TipoConsulta.Tipo == 'Articulo'"
                                                   name="fechaConsulta" href="#"
                                                   buttons="yes"
                                                   editable-text="ValorConsulta"
                                                   onaftersave="">{{ ValorConsulta}}</a>
                                            </div>
                                            <div class="col-lg-3 col-md-3 col-sm-3 col-xs-3">
