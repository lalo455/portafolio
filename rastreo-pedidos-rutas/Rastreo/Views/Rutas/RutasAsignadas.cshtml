

@{
    Layout = null;
}
@using System.Threading;
@using System.Security.Claims;

<!DOCTYPE html>
<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>Entregas WEB | Rutas</title>
    <meta name="viewport" content="width=device-width" />
    <link href="~/Librarys/Bootstrap/Css/bootstrap7.min.css" rel="stylesheet" />
    <link href="~/Librarys/Bootstrap/Css/xeditable.css" rel="stylesheet" />
    <link href="~/Librarys/Growl_v2/angular-growl.min.css" rel="stylesheet" />
    @*<link href="~/Content/Estilos.css" rel="stylesheet" />*@
    <link href="~/Librarys/Bootstrap/Css/jquery-ui.css" rel="stylesheet" />
    <link href="~/Librarys/Messi/messi.min.css" rel="stylesheet" />
    @*<link href="../Content/Tablas.css" rel="stylesheet" />
        <link href="~/Content/Footer.css" rel="stylesheet" />
        <link href="../Content/tabs.css" rel="stylesheet" />*@
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
    <script src="~/Librarys/Jquery/jquery-3.2.1.min.js"></script>
    <script src="~/Librarys/Angular/angular.js"></script>
    <script src="~/jspdf/jspdf/dist/jspdf.min.js"></script>
    <script src="~/jspdf/jspdf/dist/jspdf.debug.js"></script>
    <script src="https://npmcdn.com/tether@1.2.4/dist/js/tether.min.js"></script>
    <script src="~/Librarys/Bootstrap/Js/bootstrap7.min.js"></script>
    <script src="~/Librarys/Jquery/jquery-ui.min.js"></script>
    <script src="~/Librarys/Bootstrap/Js/ui-bootstrap-2.5.0.min.js"></script>
    <script src="~/Librarys/Bootstrap/Js/ui-bootstrap-tpls.min.js"></script>
    <script src="~/Librarys/Angular/angular-ui-utils.min.js"></script>
    <script src="~/Librarys/Messi/messi.min.js"></script>
    <script src="~/Librarys/Jquery/jquery.dataTables.min.js"></script>
    <script src="~/Librarys/Bootstrap/Js/dataTables.bootstrap.min.js"></script>
    <script src="~/Librarys/dirPagination.js"></script>
    <script src="~/Librarys/Growl_v2/angular-growl.min.js"></script>
    <script src="~/Librarys/Jquery/xeditable.min.js"></script>
    @*<script src="~/Librarys/Angular/dataGrid.js"></script>*@
    <script src="~/Scripts/Ruta/RutasAsignadas.js"></script>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha3/dist/css/bootstrap.min.css"
          rel="stylesheet" />
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha3/dist/js/bootstrap.bundle.min.js"></script>

    <link href="~/Content/Site.css" rel="stylesheet" />
</head>
<body ng-app="rutasAsignadasApp" ng-controller="rutasAsignadasController" class="bg-light text-center">
    <!-- Navbar -->
    <div class="navbar">
        <div class="logo">

            <i class="fa-solid fa-route" onclick="location.href='@Url.Action("Menu", "Menu")'"> </i> <!-- Logo -->
            Seleccione la ruta
        </div>
        <form class="form-inline my-2 my-lg-0">
            <button onclick="location.href='@Url.Action("Menu", "Menu")'" class="btn btn-primary " type="submit">
                <i class="fa-solid fa-arrow-left" style="color: #ffffff;"></i>
            </button>
        </form>
        <div class="user-info">

            @{
                <spam style="color: #FFFFFF;" id="UsuarioLogin">  @User.Identity.Name  </spam>
            }
            <br />
            <a></a>&nbsp;


            <a href="@Url.Action("Logout", "Login")" class="fas fa-sign-out" style="color: #FFD43B" title="Salir">  Salir  </a>

        </div>
    </div>

    <div class="container mt-4">

        <!-- Spinner de carga -->
        <div ng-show="cargando">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">Cargando...</span>
            </div>
        </div>

        <!-- Mensaje si no hay rutas -->
        <p class="text-danger" ng-show="rutas.length === 0 && !cargando">No hay rutas disponibles.</p>

        <div class="container text-center ">
            <input type="date" class="form-control w-25 mx-auto" ng-model="fecha" ng-change="cambiarFecha()" max="{{hoy}}">
        </div>

        <!-- Botones de rutas -->
        <div class="row g-3 mt-3">
            <div class="col-6 col-md-4" ng-repeat="ruta in rutas">
                <button class="btn btn-outline-secondary btn-custom w-100" ng-click="irARuta(ruta.RutaName)">{{ ruta.RutaName }}</button>
            </div>
        </div>
    </div>
</body>
</html>