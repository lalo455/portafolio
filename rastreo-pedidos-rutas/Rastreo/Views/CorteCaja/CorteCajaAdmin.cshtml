@{
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>Entregas WEB | Admin Corte caja</title>
    <link href="~/Librarys/Bootstrap/Css/bootstrap7.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
    <script src="~/Librarys/Jquery/jquery-3.2.1.min.js"></script>
    <script src="~/Librarys/Angular/angular.js"></script>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="~/Content/Site.css" rel="stylesheet" />
    <script src="~/Scripts/CorteCaja/corteCajaAdmin.js"></script>
</head>
<body ng-app="corteCajaAdminApp" ng-controller="corteCajaAdminController" class="bg-light text-center">
    <!-- Navbar -->
    <div class="navbar">
        <div class="logo">
            <i class="fas fa-cash-register" onclick="location.href='@Url.Action("Menu", "Menu")'"> </i>
            Admin: Corte de caja
        </div>
        <form class="form-inline my-2 my-lg-0">
            <button onclick="window.history.back();" class="btn btn-primary " type="submit">
                <i class="fa-solid fa-arrow-left" style="color: #ffffff;"></i>
            </button>
        </form>
        <div class="user-info">
            <span style="color: #FFFFFF;" id="UsuarioLogin">@User.Identity.Name</span>
            <br />
            <a></a>&nbsp;
            <a href="@Url.Action("Logout", "Login")" class="fas fa-sign-out" style="color: #FFD43B" title="Salir"> Salir </a>
        </div>
    </div>

    <div class="alert alert-{{tipoMensaje}} alert-dismissible mt-3" ng-if="mensajeVisible">
        {{ mensajeTexto }}
        <button type="button" class="btn-close" ng-click="cerrarMensaje()"></button>
    </div>

    <div class="container mt-4">
        <h3 class="text-center fw-bold">Consulta de Corte de Caja (Administrador)</h3>
        
        <div class="row mt-4 justify-content-center">
            <div class="col-md-4">
                <label class="form-label">Fecha:</label>
                <input type="date" class="form-control" ng-model="fecha" />
            </div>
            <div class="col-md-4">
                <label class="form-label">Repartidor:</label>
                <select class="form-select" ng-model="repartidorSeleccionado" ng-options="r.IdRepartidor as r.Nombre for r in repartidores">
                    <option value="">-- Seleccione Repartidor --</option>
                </select>
            </div>
        </div>
        
        <div class="row mt-4 justify-content-center">
            <div class="col-md-4">
                <button class="btn btn-primary w-100" ng-click="generarReporte()" ng-disabled="cargando || !fecha || !repartidorSeleccionado">
                    {{ cargando ? "Generando Reporte..." : "Generar Reporte PDF" }}
                </button>
            </div>
        </div>
    </div>
</body>
</html>
