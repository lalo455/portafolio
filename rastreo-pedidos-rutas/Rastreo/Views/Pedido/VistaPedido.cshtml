    <div class="container" style="margin-top:2em;">
        <div class="row form-horizontal">
            <div class="form-group">
                <label for="male" class="control-label col-md-2">Direccion de Entrega: </label>
                <div class="col-md-3">
                    <!--<div class="dropdown">
                        <select class="form-control" id="direccionE">
                            <option></option>
                        </select>
                    </div>-->
                    <label style="padding-top:7px;" id="direccionE"></label>
                </div>
            </div>
            <div class="col-lg-7">
                <label style="width:25em; margin-top:.5em; margin-left:13em; border:1px solid white; " id="direc">  </label>
            </div>
        </div>

        <div class="row" style="margin-top:2em;">
            <div class="col-lg-4 col-lg-offset-1" style="text-align:center;">
                <button id="EnvCoti" type="button" class="btn btn-primary">Enviar Cotización</button>
            </div>
            <!--<div class="col-lg-4 col-lg-offset-1" style="text-align:center;">
                <button id="clearForm" type="button" class="btn btn-primary">Limpiar</button>
            </div>-->
        </div>
    </div>

    <!--ALERTAS-->
    <div class="modal fade" id="postPediExito">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-body">
                    <div class="alert alert-success alert-dismissable">
                        <strong>Se enviaron correctamente los datos. </strong>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="modal fade" id="postPediError">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-body">
                    <div class="alert alert-danger alert-dismissable">
                        <strong>No ha sido posible enviar la Pedido.</strong>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!--otra modal para mensajes de comobox-->
    <div id="popup">
        <div id="topbar">
            <span class="close">×</span>
            Mensaje
        </div>
        <div id="content"><h4 id="mensajito"></h4></div>
    </div>

    <div id="popup2">
        <div id="topbar2">
            <span class="close2">×</span>
            Mensaje
        </div>
