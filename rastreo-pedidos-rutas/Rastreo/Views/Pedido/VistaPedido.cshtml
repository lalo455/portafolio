                            <button id="getBPListP" ng-click="mostrarModalSN();" type="button" class="btn btn-info btn-md"><span class="glyphicon glyphicon-plus-sign"></span></button>
                            <input id="priceList" name="Height" type="text" style="width:20px; visibility:hidden" value="{{customerBP.ListaPrecios}}"/>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-lg-6">
                <!--COLUMNA 1-->
                <div class="form-group">
                    <label for="male" class="control-label col-md-2">Número de Pedido</label>
                    <div class="col-md-6">
                        <!--<input id="Referencia" name="Height" type="text" class="form-control inputstl" />-->
