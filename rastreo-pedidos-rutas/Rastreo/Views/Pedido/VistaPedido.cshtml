        <!--Tabla de ARTICULOS agregados-->
        <div style="width: 90%; margin-left: 100px; padding-left: 0px; padding-right: 0px; background-color: #EEEEEE;" class="container">
            <table id="tabPedidoP" class="table">
                <thead>
                    <tr>
                        <th>#</th>
                        <th>Artículo</th>
                        <th>Descripción</th>
                        <th>Cantidad</th>
                        <th>Precio</th>
                        <th>IVA</th>
                        <th>Total</th>
                        <th>Entrega</th>
                        <th>Acciones</th>
                    </tr>
                </thead>
                <tbody id="pedido">
                    <tr id="eliminar" ng-repeat="articulo in ListaItemDetalle">
                        <td>{{$index + 1}}</td>
                        <td>{{articulo.Codigo}}</td>  
                        <td>{{articulo.Nombre}}</td>
                        <td>{{articulo.Cantidad}}</td>
                        <td>{{articulo.Precio}}</td>
                        <td>{{articulo.IVA}}</td>
                        <td>{{articulo.Total}}</td>
                        <td>{{articulo.FechaEntrega}}</td>
                        <td>Editar</td>
                    </tr>

                </tbody>
            </table>
            <div id="" class="row" style="background-color: white; margin-left: 700px; margin-right: 10px;">
                <div id="totalTotal" class="col-md-2 text-left"><span style="font-weight: bold;">Total</span></div>
                <div class="col-md-1 text-center" style="margin-left:60px"><span id="costoTotalNeto" style="font-weight: bold;">${{TotalAPagar}}</span></div>
            </div>
            <div class="row">
                <div class="col-md-10 text-right">
                    <ul class="pagination pagination-lg pager" id="pedPaginador"></ul>
                </div>
