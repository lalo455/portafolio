@{
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>
    <title>Cotizaciones</title>
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <link href="~/Librarys/Bootstrap/Css/bootstrap7.min.css" rel="stylesheet" />
    <link href="~/Librarys/Bootstrap/Css/xeditable.css" rel="stylesheet" />
    <link href="~/Librarys/Growl_v2/angular-growl.min.css" rel="stylesheet" />
    <link href="~/Content/MP.css" rel="stylesheet" />
    <link href="~/Librarys/Bootstrap/Css/jquery-ui.css" rel="stylesheet" />
    <link href="~/Librarys/Messi/messi.min.css" rel="stylesheet" />
    <link href="~/Content/Footer.css" rel="stylesheet" />
    <script src="~/Librarys/Jquery/jquery-3.2.1.min.js"></script>
    <script src="~/Librarys/Angular/angular.js"></script>
    <script src="~/jspdf/jspdf/dist/jspdf.min.js"></script>
    <script src="~/jspdf/jspdf/dist/jspdf.debug.js"></script>
    <script src="https://npmcdn.com/tether@1.2.4/dist/js/tether.min.js"></script>
    <script src="~/Librarys/Bootstrap/Js/bootstrap7.min.js"></script>
    <script src="~/Librarys/Jquery/jquery-ui.min.js"></script>
    <script src="~/Librarys/Bootstrap/Js/ui-bootstrap-2.5.0.min.js"></script>
    <script src="~/Librarys/Bootstrap/Js/ui-bootstrap-tpls.min.js"></script>
    <script src="~/Librarys/Angular/angular-ui-utils.min.js"></script>
    <script src="~/Librarys/Messi/messi.min.js"></script>
    <script src="~/Librarys/Jquery/jquery.dataTables.min.js"></script>
    <script src="~/Librarys/Bootstrap/Js/dataTables.bootstrap.min.js"></script>
    <script src="~/Librarys/dirPagination.js"></script>
    <script src="~/Librarys/Growl_v2/angular-growl.min.js"></script>
    <script src="~/Librarys/Jquery/xeditable.min.js"></script>
    <script src="~/Librarys/Angular/dataGrid.js"></script>
    <script src="~/Scripts/appCotizacion.js"></script>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" rel="stylesheet">
    @using Microsoft.AspNet.Identity
    @using Microsoft.AspNet.Identity.Owin;
    @using System.Security.Claims;
</head>

<body ng-app="appCotizacion" ng-controller="consultaCotizacionController">
    <nav class="navbar navbar-default" id="myDIV">
        <div class="container-fluid">
            <div class="navbar-header">
                <!-- Botón responsive -->
                <button type="button" class="navbar-toggle collapsed" data-toggle="collapse" data-target="#navbar-romihn">
                    <span class="icon-bar"></span>
                    <span class="icon-bar"></span>
                    <span class="icon-bar"></span>
                </button>

                <!-- Logo -->
                <a class="navbar-brand" style="padding: 5px 15px;">
                    <img src="~/Images/ROMIHN.png" alt="ROMIHN" style="padding: 5px 15px;">
                </a>
            </div>

            <!-- Menú colapsable -->
            <div class="collapse navbar-collapse" id="navbar-romihn">
                <ul class="nav navbar-nav navbar-right">
                    <!-- Menú DOCUMENTOS -->
                    <li class="">
                        <a href="#" class="dropdown-toggle menu-romihn2 active" data-toggle="dropdown">DOCUMENTOS <span class="caret"></span></a>
                        <ul class="dropdown-menu">
                            <li id="menuOp1">
                                <a class="opcion-nav" href="@Url.Action("PaginaInicio", "MasterPage")">Cotización<span ng-show="rol == 'V' || rol == 'C'"> / Pedido</span></a>
                            </li>
                            <li id="menuOp2" style="display:none;">
                                <a class="opcion-nav" href="@Url.Action("PaginaInicio", "MasterPage")">Cotización<span ng-show="rol == 'V' || rol == 'C'"> / Pedido</span></a>
                            </li>
                            <li role="separator" class="divider"></li>
                            <li>
                                <a class="opcion-nav" href="@Url.Action("Pedidos", "Pedido")" ng-show="rol == 'V' || rol == 'C'">Consulta pedidos</a>
                            </li>
                            <li role="separator" class="divider"></li>
                            <li class="active">
                                <a class="opcion-nav" href="@Url.Action("Cotizacion", "Cotizacion")">Consulta cotizaciones</a>
                            </li>
                            <li role="separator" class="divider"></li>
                            <li>
                                <a class="opcion-nav" href="@Url.Action("Facturas", "Pedido")" ng-show="rol == 'V' || rol == 'C'">Consulta facturas</a>
                            </li>
                        </ul>
                    </li>

                    <!-- Menú REPORTES -->
                    <li class="dropdown">
                        <a href="#" class="dropdown-toggle menu-romihn2" data-toggle="dropdown">REPORTES <span class="caret"></span></a>
                        <ul class="dropdown-menu">
                            <li>
                                <a class="opcion-nav" href="@Url.Action("Inventario", "Reportes")">Inventario ROMIHN</a>
                            </li>
                            <li role="separator" class="divider"></li>
                            <li>
                                <a class="opcion-nav" href="@Url.Action("InventarioRC", "Reportes")">Inventario RC</a>
                            </li>
                            <li role="separator" class="divider"></li>
                            <li>
                                <a class="opcion-nav" href="@Url.Action("Reimpresion", "Reportes")">Reimpresión de documentos</a>
                            </li>
                            <li role="separator" class="divider"></li>
                            <li>
                                <a class="opcion-nav" href="@Url.Action("Ventas", "Reportes")" ng-show="rol == 'V'">Reporte de ventas</a>
                                <a class="opcion-nav" href="@Url.Action("Compras", "Reportes")" ng-show="rol == 'C'">Reporte de compras</a>
                            </li>
                        </ul>
                    </li>

                    <!-- Otro ítem -->
                    <li><a class="menu-romihn" id="UsuarioLogin">@User.Identity.Name</a></li>

                    <!-- Botón salir -->
                    <li class="divider-left">
                        <a class="opcion-nav" href="@Url.Action("Logout","Login")">
                            <img src="~/Content/images/ICONOS/ICONO SALIDA.svg" alt="Salir" style="height:16px;" />
                            <span class="btn-salir">Salir</span>
                        </a>
                    </li>
                </ul>
            </div>
        </div>
    </nav>

    <div class="container-fluid" id="paginaInicio">
        <div class="container" style="font-family: Calibri;">
            <div class="col-lg-12 col-md-12 QuitarPadding" id="contenedorPrincipal">
                <div class="jumbotron" style="padding-top: 15px;">
                    <div id="encabezado">
                        <h2 id="encabezado-text6" class="encT" ng-show="tipo === 'N'">Consulta de cotizaciones</h2>
                        <h2 id="encabezado-text1" class="encT" ng-show="tipo === 'E'">Cotización</h2>
                        <img src="~/Content/images/ICONOS/ICONO ORDEN VENTA.svg" alt="Ícono SVG" class="icono">
                    </div>

                    <!--Inicio Seccion 6-->
                    <div ng-show="accion === '1'" style="margin-top: 6em;">
                        <div class="form-horizontal">
                            <div class="form-horizontal">
                                <div class="row">
                                    <div class="col-md-4 col-sm-4 mt-sm">
                                        <label class="control-label">Tipo consulta</label>
                                        <select ng-model="TipoConsultaC.Tipo" class="form-control inputstl"
                                                ng-model-options="{getterSetter:true}"
                                                ng-change="VisualizarTipoConsultaC()"
                                                ng-options="s.value as s.text for s in ListaTipoConsultaC">
                                            <option style="display:none" value="">Seleccione opción...</option>
                                        </select>
                                    </div>

                                    <div class="col-md-4 col-sm-4" ng-show="TipoConsultaC.Tipo != 'Todos'">
                                        <label class="control-label">
                                            {{TipoConsultaC.Tipo == 'Fecha' ? 'Desde' : TipoConsultaC.Tipo == 'DocNum' ? 'No. Doc.' : TipoConsultaC.Tipo == 'Articulo' ? 'Código de artículo' : '' }}
                                        </label>

                                        <div id="tipoConsultaC" class="overwrite-bootstrap" ng-show="TipoConsultaC.Tipo != 'Todos'">
                                            <a class="form-control inputstl"
                                               ng-show="TipoConsultaC.Tipo == 'Fecha'"
                                               name="fechaConsulta"
                                               href="#"
                                               editable-date="ValorConsultaC"
                                               buttons="yes"
                                               onaftersave="">
                                                {{ ValorConsultaC | date:"dd-MM-yyyy"}}
                                            </a>

                                            <a class="form-control inputstl"
                                               ng-show="TipoConsultaC.Tipo == 'DocNum'"
                                               name="fechaConsulta"
                                               href="#"
                                               buttons="yes"
                                               editable-text="ValorConsultaC"
                                               onaftersave="">
                                                {{ ValorConsultaC}}
                                            </a>

                                            <a class="form-control inputstl"
                                               ng-show="TipoConsultaC.Tipo == 'Articulo'"
                                               name="fechaConsulta"
                                               href="#"
                                               buttons="yes"
                                               editable-text="ValorConsultaC"
                                               onaftersave="">
                                                {{ ValorConsultaC}}
                                            </a>
                                        </div>
                                    </div>

                                    <div class="col-md-4 col-sm-4">
                                        <label class="control-label" style="color: transparent;">Botón</label>
                                        <div>
                                            <button type="button" class="btn btn-default"
                                                    ng-click="ConsultaCotizaciones();">
                                                <img src="~/Images/search1.png" />
                                                <span><strong>Buscar cotizaciones</strong></span>
                                            </button>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <div class="form-horizontal">
                                <div class="row">
                                    <div class="col-md-4 col-sm-4">
                                        <label class="control-label">Buscar</label>
                                        <input ng-model="QryConsultaCotizacion" id="search" class="form-control"
                                               placeholder="Texto de filtrado">
                                    </div>

                                    <div class="col-md-4 col-sm-4">
                                        <label class="control-label">Lineas por página</label>
                                        <input type="number" min="1" max="100" class="form-control"
                                               ng-model="QtyConsultaCotizacion">
                                    </div>
                                </div>
                            </div>

                            <div class="row mt-md">
                                <div class="col-lg-12 col-md-12 col-sm-12">
                                    <label class="control-label">
                                        ** De clic sobre la cotización que desea visualizar y/o actualizar.
                                    </label>
                                    <div class="table-responsive">
                                        <table id="tabCotizacionC" class="table table-hover table-responsive">
                                            <thead>
                                                <tr>
                                                    <th>#</th>
                                                    <th class="text-center">Cliente</th>
                                                    <th class="text-center">No. Doc.</th>
                                                    <th class="text-center">Status</th>
                                                    <th class="text-center">F. cotizacion</th>
                                                    <th class="text-center">Modelo</th>
                                                    <th class="text-center">Descripción</th>
                                                    <th class="text-center">Unidades medida</th>
                                                    <th class="text-center">Cotizado</th>
                                                    <th class="text-center">Precio</th>
                                                    <th class="text-center">Total</th>
                                                </tr>
                                            </thead>
                                            <tbody id="cotizacion" class="table-bordered">
                                                <tr id="eliminar"
                                                    dir-paginate="cotizacion in ListaCotizaciones|orderBy:sortKey:reverse|filter:QryConsultaCotizacion|itemsPerPage:QtyConsultaCotizacion"
                                                    pagination-id="queryCotizacion">

                                                    <td class="text-center"
                                                        ng-click="cargarCotizacion(cotizacion.NoCotizacion, cotizacion.DocDate)">
                                                        {{ListaCotizaciones.indexOf(cotizacion) + 1}}
                                                    </td>
                                                    <td class="text-center"
                                                        ng-click="cargarCotizacion(cotizacion.NoCotizacion, cotizacion.DocDate)">
                                                        {{cotizacion.Cliente}}
                                                    </td>
                                                    <td class="text-center"
                                                        ng-click="cargarCotizacion(cotizacion.NoCotizacion, cotizacion.DocDate)">
                                                        {{cotizacion.NoCotizacion}}
                                                    </td>
                                                    <td class="text-center"
                                                        ng-click="cargarCotizacion(cotizacion.NoCotizacion, cotizacion.DocDate)">
                                                        {{cotizacion.DocStatus}}
                                                    </td>
                                                    <td class="text-center"
                                                        ng-click="cargarCotizacion(cotizacion.NoCotizacion, cotizacion.DocDate)">
                                                        {{cotizacion.DocDate | date:'dd/MM/yyyy'}}
                                                    </td>
                                                    <td class="text-center"
                                                        ng-click="cargarCotizacion(cotizacion.NoCotizacion, cotizacion.DocDate)">
                                                        {{cotizacion.ItemCode}}
                                                    </td>
                                                    <td class="text-center"
                                                        ng-click="cargarCotizacion(cotizacion.NoCotizacion, cotizacion.DocDate)">
                                                        {{cotizacion.ItemName}}
                                                    </td>
                                                    <td class="text-center"
                                                        ng-click="cargarCotizacion(cotizacion.NoCotizacion, cotizacion.DocDate)">
                                                        {{cotizacion.UMVendida| number:0}}
                                                    </td>
                                                    <td class="text-center"
                                                        ng-click="cargarCotizacion(cotizacion.NoCotizacion, cotizacion.DocDate)">
                                                        {{cotizacion.QtyCotizada| number:0}}
                                                    </td>
                                                    <td class="text-center"
                                                        ng-click="cargarCotizacion(cotizacion.NoCotizacion, cotizacion.DocDate)">
                                                        ${{cotizacion.Precio| number:2}}MXN
                                                    </td>
                                                    <td class="text-center"
                                                        ng-click="cargarCotizacion(cotizacion.NoCotizacion, cotizacion.DocDate)">
                                                        ${{cotizacion.Total| number:2}}MXN
                                                    </td>

                                                </tr>
                                            </tbody>
                                        </table>
                                    </div>
                                    <dir-pagination-controls max-size="5" direction-links="true" boundary-links="true"
                                                             pagination-id="queryCotizacion">
                                    </dir-pagination-controls>
                                </div>
                            </div>
                            <div growl></div>
                        </div>
                    </div>
                    <!--Fin Seccion 6-->
                    <!--Inicio Seccion 1-->
                    <div ng-show="accion === '2'" id="PedidoView">
                        <div class="form-horizontal">
                            <div class="row">
                                <div class="col-md-4 col-sm-4" ng-show="rol != 'A' && rol != 'O'">
                                    <label class="control-label">Tipo pedido</label>
                                    <select ng-model="Base"
                                            class="form-control inputstl custom-select"
                                            id="selectCurveado"
                                            ng-disabled="DocEntryPedido != 0"
                                            ng-model-options="{getterSetter:true}"
                                            ng-options="D.Tipo as D.Documento for D in DocBase"
                                            ng-change="ValidarTipo()">
                                        <option style="display:none" value="">Seleccione opción...</option>
                                    </select>
                                </div>
                                <div class="col-md-4 col-sm-4" ng-show="rol === 'A' || rol === 'O'">
                                    <label class="control-label">Tipo pedido</label>
                                    <select ng-model="Base"
                                            class="form-control inputstl custom-select"
                                            ng-disabled="DocEntryPedido != 0 || rol === 'A' || rol === 'O'"
                                            ng-model-options="{getterSetter:true}"
                                            ng-change="CargarInputFPP(),ValidarTipo()"
                                            ng-options="D.Tipo as D.Documento for D in DocBase">
                                        <option style="display:none" value="">Seleccione opción...</option>
                                    </select>
                                </div>
                            </div>

                            <div class="row" ng-show="rol == 'V'">
                                <div class="col-md-4 col-sm-4 mt-sm">
                                    <label class="control-label">Cliente</label>
                                    <input type="text"
                                           class="form-control"
                                           disabled=""
                                           placeholder="Código cliente"
                                           ng-model="customerBP.CardCode">
                                </div>
                                <div class="col-md-4 col-sm-4 mt-sm">
                                    <label class="control-label text-white">Razón social</label>
                                    <input type="text"
                                           class="form-control"
                                           disabled=""
                                           placeholder="Nombre de cliente"
                                           ng-model="customerBP.CardName">
                                </div>
                                <div class="col-md-4 col-sm-4 mt-sm" ng-show="Base.length != 0 && DocEntryPedido == 0">
                                    <button type="button"
                                            class="btn btn-default d-block"
                                            ng-click="mostrarModalSN()">
                                        <img src="~/Images/bp.png" />
                                        <span><strong>Buscar</strong></span>
                                    </button>
                                </div>
                            </div>

                            <div class="row" ng-show="rol =='V'">
                                <div class="col-md-4 col-sm-4 mt-sm">
                                    <label class="control-label">Forma de envío</label>
                                    <select ng-model="EnvioTipo.Forma" class="form-control inputstl"
                                            ng-model-options="{getterSetter:true}"
                                            ng-change="ArmarListaFormaEnvio(EnvioTipo.Forma)"
                                            ng-options="D.Tipo as D.Documento for D in EnvioTipo.ListaFormaEnvio">
                                        <option style="display:none" value="">Seleccione opción...</option>
                                    </select>
                                </div>
                                <div class="col-md-4 col-sm-4 mt-sm">
                                    <label class="control-label">Tipo de envío</label>
                                    <select ng-model="TipoEnvio.Forma" class="form-control inputstl"
                                            ng-model-options="{getterSetter:true}"
                                            ng-change="ArmarListaTipoEnvio(TipoEnvio.Forma)"
                                            ng-options="D.Tipo as D.Documento for D in TipoEnvio.ListaTipoEnvio">
                                        <option style="display:none" value="">Seleccione opción...</option>
                                    </select>
                                </div>
                                <div class="col-md-4 col-sm-4 mt-sm" ng-show="Base=='Pedido' || DocEntryPedido != 0">
                                    <label class="control-label">Método de pago</label>
                                    <select ng-model="MetodoPago.Forma" class="form-control inputstl"
                                            ng-show="Base=='Pedido' || DocEntryPedido!=0" ng-disabled="rol !='V' || DocEntryPedido==0"
                                            ng-change="ArmarListaMetodoPago(MetodoPago.Forma)"
                                            ng-options="D.Tipo as D.Tipo+'-'+D.Documento for D in  MetodoPago.ListaMetodoPago">
                                        <option style="display:none" value="">Seleccione opción...</option>
                                    </select>
                                </div>
                                <div class="col-md-4 col-sm-4 mt-sm" ng-show="Base =='Pedido' || DocEntryPedido != 0">
                                    <label class="control-label">Forma de pago</label>
                                    <select ng-model="DatosFP.Forma" class="form-control inputstl"
                                            ng-show="Base =='Pedido'|| DocEntryPedido!=0" ng-disabled="rol !='V'"
                                            ng-model-options="{getterSetter:true}"
                                            ng-change="ArmarFormaDepago(DatosFP.Forma)"
                                            ng-options="D.PymCode as D.PymCode+'-'+D.Descrip for D in DatosFP.ListaFormaPago">
                                        <option style="display:none" value="">Seleccione opción...</option>
                                    </select>
                                </div>
                            </div>

                            <div class="row" ng-show=" rol == 'V'">
                                <div class="col-md-4 col-sm-4 mt-sm">
                                    <label class="control-label">Saldo actual</label>
                                    <input type="text"
                                           class="form-control"
                                           disabled=""
                                           placeholder="$0"
                                           ng-value="'$'+customerBP.SaldoSt">
                                </div>
                                <div class="col-md-4 col-sm-4 mt-sm">
                                    <label class="control-label">Crédito disponible</label>
                                    <input type="text"
                                           class="form-control"
                                           disabled=""
                                           placeholder="$0"
                                           ng-value="'$'+customerBP.CreditoSt">
                                </div>
                                <div class="col-md-4 col-sm-4 mt-sm" ng-show=" rol == 'V'">
                                    <label ng-show="Base == 'Pedido' || DocEntryPedido != 0" class="control-label">
                                        Uso de CFDI
                                    </label>
                                    <select ng-model="DatosCDFI.Forma"
                                            class="form-control inputstl"
                                            ng-show="Base =='Pedido' || DocEntryPedido != 0"
                                            ng-model-options="{getterSetter:true}"
                                            ng-change="ArmarListaCDFI(DatosCDFI.Forma)"
                                            ng-options="A.Code as A.Code+'-'+A.Descrip for A in DatosCDFI.ListaCDFI">
                                        <option style="display:none" value="">Seleccione opción...</option>
                                    </select>
                                </div>
                            </div>

                            <div ng-show="rol == 'C'|| rol == 'A'|| rol =='O'">
                                <div class="row">
                                    <div class="col-md-4 col-sm-4 mt-sm">
                                        <label class="control-label">Cliente</label>
                                        <input type="text"
                                               class="form-control"
                                               disabled=""
                                               placeholder="Código cliente"
                                               ng-model="customerBP.CardCode" />
                                    </div>
                                    <div class="col-md-4 col-sm-4 mt-sm">
                                        <label class="control-label text-white">Razón social</label>
                                        <input type="text"
                                               class="form-control"
                                               disabled=""
                                               placeholder="Nombre de cliente"
                                               ng-model="customerBP.CardName">
                                    </div>
                                    <div class="col-md-4 col-sm-4 mt-sm">
                                        <label class="control-label text-white">
                                            Editar
                                            <input type="checkbox" ng-model="checked">
                                        </label>
                                    </div>
                                </div>
                                <div class="row">
                                    <div class="col-md-4 col-sm-4 mt-sm">
                                        <label class="control-label">Forma de envío</label>
                                        <select ng-model="EnvioTipo.Forma" class="form-control inputstl"
                                                ng-model-options="{getterSetter:true}"
                                                ng-change="ArmarListaFormaEnvio(EnvioTipo.Forma)"
                                                ng-options="D.Tipo as D.Documento for D in EnvioTipo.ListaFormaEnvio">
                                            <option style="display:none" value="">Seleccione opción...</option>
                                        </select>
                                    </div>
                                    <div class="col-md-4 col-sm-4 mt-sm">
                                        <label class="control-label">Tipo de envío</label>
                                        <select ng-model="TipoEnvio.Forma" class="form-control inputstl"
                                                ng-model-options="{getterSetter:true}"
                                                ng-change="ArmarListaTipoEnvio(TipoEnvio.Forma)"
                                                ng-options="D.Tipo as D.Documento for D in TipoEnvio.ListaTipoEnvio  ">
                                            <option style="display:none" value="">Seleccione opción...</option>
                                        </select>
                                    </div>
                                    <div class="col-md-4 col-sm-4 mt-sm">
                                        <label ng-show="DocEntryPedido != 0" class="control-label">Método de pago</label>
                                        <select ng-model="MetodoPago.Forma" class="form-control inputstl"
                                                ng-show="DocEntryPedido != 0"
                                                ng-disabled="rol !='V' || DocEntryPedido==0"
                                                ng-model-options="{getterSetter:true}"
                                                ng-change="ArmarListaMetodoPago(MetodoPago.Forma)"
                                                ng-options="D.Tipo as D.Tipo+'-'+D.Documento for D in  MetodoPago.ListaMetodoPago">
                                            <option style="display:none" value="">Seleccione opción...</option>
                                        </select>
                                    </div>
                                </div>

                                <div class="row">
                                    <div class="col-md-4 col-sm-4 mt-sm">
                                        <label ng-show="DocEntryPedido != 0" class="control-label">Forma de pago</label>
                                        <select ng-model="DatosFP.Forma" class="form-control inputstl"
                                                ng-show="DocEntryPedido != 0"
                                                ng-disabled="rol !='V'"
                                                ng-model-options="{getterSetter:true}"
                                                ng-change="ArmarFormaDepago(DatosFP.Forma)"
                                                ng-options="D.PymCode as D.PymCode+'-'+D.Descrip for D in DatosFP.ListaFormaPago">
                                            <option style="display:none" value="">Seleccione opción...</option>
                                        </select>
                                    </div>
