@{
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>
    <title>Pedidos</title>
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <link href="~/Librarys/Bootstrap/Css/bootstrap7.min.css" rel="stylesheet" />
    <link href="~/Librarys/Bootstrap/Css/xeditable.css" rel="stylesheet" />
    <link href="~/Librarys/Growl_v2/angular-growl.min.css" rel="stylesheet" />
    <link href="~/Content/MP.css" rel="stylesheet" />
    <link href="~/Librarys/Bootstrap/Css/jquery-ui.css" rel="stylesheet" />
    <link href="~/Librarys/Messi/messi.min.css" rel="stylesheet" />
    <link href="~/Content/Footer.css" rel="stylesheet" />
    <script src="~/Librarys/Jquery/jquery-3.2.1.min.js"></script>
    <script src="~/Librarys/Angular/angular.js"></script>
    <script src="~/jspdf/jspdf/dist/jspdf.min.js"></script>
    <script src="~/jspdf/jspdf/dist/jspdf.debug.js"></script>
    <script src="https://npmcdn.com/tether@1.2.4/dist/js/tether.min.js"></script>
    <script src="~/Librarys/Bootstrap/Js/bootstrap7.min.js"></script>
    <script src="~/Librarys/Jquery/jquery-ui.min.js"></script>
    <script src="~/Librarys/Bootstrap/Js/ui-bootstrap-2.5.0.min.js"></script>
    <script src="~/Librarys/Bootstrap/Js/ui-bootstrap-tpls.min.js"></script>
    <script src="~/Librarys/Angular/angular-ui-utils.min.js"></script>
    <script src="~/Librarys/Messi/messi.min.js"></script>
    <script src="~/Librarys/Jquery/jquery.dataTables.min.js"></script>
    <script src="~/Librarys/Bootstrap/Js/dataTables.bootstrap.min.js"></script>
    <script src="~/Librarys/dirPagination.js"></script>
    <script src="~/Librarys/Growl_v2/angular-growl.min.js"></script>
    <script src="~/Librarys/Jquery/xeditable.min.js"></script>
    <script src="~/Librarys/Angular/dataGrid.js"></script>
    <script src="~/Scripts/appPedido.js"></script>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" rel="stylesheet">
    @using Microsoft.AspNet.Identity
    @using Microsoft.AspNet.Identity.Owin;
    @using System.Security.Claims;
</head>

<body ng-app="appPedidos" ng-controller="consultaPedidoController">
    <nav class="navbar navbar-default" id="myDIV">
        <div class="container-fluid">
            <div class="navbar-header">
                <!-- Botón responsive -->
                <button type="button" class="navbar-toggle collapsed" data-toggle="collapse" data-target="#navbar-romihn">
                    <span class="icon-bar"></span>
                    <span class="icon-bar"></span>
                    <span class="icon-bar"></span>
                </button>

                <!-- Logo -->
                <a class="navbar-brand" style="padding: 5px 15px;">
                    <img src="~/Images/ROMIHN.png" alt="ROMIHN" style="padding: 5px 15px;">
                </a>
            </div>

            <!-- Menú colapsable -->
            <div class="collapse navbar-collapse" id="navbar-romihn">
                <ul class="nav navbar-nav navbar-right">
                    <!-- Menú DOCUMENTOS -->
                    <li class="">
                        <a href="#" class="dropdown-toggle menu-romihn2" data-toggle="dropdown">DOCUMENTOS <span class="caret"></span></a>
                        <ul class="dropdown-menu">
                            <li id="menuOp1">
                                <a class="opcion-nav" href="@Url.Action("PaginaInicio", "MasterPage")">Cotización<span ng-show="rol == 'V' || rol == 'C'"> / Pedido</span></a>
                            </li>
                            <li id="menuOp2" style="display:none;">
                                <a class="opcion-nav" href="@Url.Action("PaginaInicio", "MasterPage")">Cotización<span ng-show="rol == 'V' || rol == 'C'"> / Pedido</span></a>
                            </li>
                            <li role="separator" class="divider"></li>
                            <li class="active">
                                <a class="opcion-nav" href="@Url.Action("Pedidos", "Pedido")" ng-show="rol == 'V' || rol == 'C'">Consulta pedidos</a>
                            </li>
                            <li role="separator" class="divider"></li>
                            <li>
                                <a class="opcion-nav" href="@Url.Action("Cotizacion", "Cotizacion")">
                                    Consulta cotizaciones
                                </a>
                            </li>
                            <li role="separator" class="divider"></li>
                            <li>
                                <a class="opcion-nav" href="@Url.Action("Facturas", "Pedido")" ng-show="rol == 'V' || rol == 'C'">Consulta facturas</a>
                            </li>
                        </ul>
                    </li>

                    <!-- Menú REPORTES -->
                    <li class="dropdown">
                        <a href="#" class="dropdown-toggle menu-romihn2" data-toggle="dropdown">REPORTES <span class="caret"></span></a>
                        <ul class="dropdown-menu">
                            <li>
                                <a class="opcion-nav" href="@Url.Action("Inventario", "Reportes")">Inventario ROMIHN</a>
                            </li>
                            <li role="separator" class="divider"></li>
                            <li>
                                <a class="opcion-nav" href="@Url.Action("InventarioRC", "Reportes")">Inventario RC</a>
                            </li>
                            <li role="separator" class="divider"></li>
                            <li>
                                <a class="opcion-nav" href="@Url.Action("Reimpresion", "Reportes")">Reimpresión de documentos</a>
                            </li>
                            <li role="separator" class="divider"></li>
                            <li>
                                <a class="opcion-nav" href="@Url.Action("Ventas", "Reportes")" ng-show="rol == 'V'">Reporte de ventas</a>
                                <a class="opcion-nav" href="@Url.Action("Compras", "Reportes")" ng-show="rol == 'C'">Reporte de compras</a>
                            </li>
                        </ul>
                    </li>

                    <!-- Otro ítem -->
                    <li><a class="menu-romihn" id="UsuarioLogin">@User.Identity.Name</a></li>

                    <!-- Botón salir -->
                    <li class="divider-left">
                        <a class="opcion-nav" href="@Url.Action("Logout","Login")">
                            <img src="~/Content/images/ICONOS/ICONO SALIDA.svg" alt="Salir" style="height:16px;" />
                            <span class="btn-salir">Salir</span>
                        </a>
                    </li>
                </ul>
            </div>
        </div>
    </nav>

    <div class="container-fluid" id="paginaInicio">
        <div class="container" style="font-family: Calibri;">
            <div class="col-lg-12 col-md-12 QuitarPadding" id="contenedorPrincipal">
                <div class="jumbotron" style="padding-top: 15px;">
                    <div id="encabezado">
                        <h2 id="encabezado-text2" class="encT">Consulta de pedidos</h2>
                        <img src="~/Content/images/ICONOS/ICONO ORDEN VENTA.svg" alt="Ícono SVG" class="icono">
                    </div>

                    <!--Inicio Seccion 2-->
                    <div style="margin-top: 6em;">
                        <div class="form-horizontal">
                            <div class="form-horizontal">
                                <div class="row">
                                    <div class="col-md-4 col-sm-4">
                                        <label class="control-label">Tipo consulta</label>
                                        <select ng-model="TipoConsulta.Tipo" class="form-control inputstl"
                                                ng-model-options="{getterSetter:true}"
                                                ng-change="VisualizarTipoConsulta()"
                                                ng-options="s.value as s.text for s in ListaTipoConsulta">
                                            <option style="display:none" value="">Seleccione opción...</option>
                                        </select>
                                    </div>

                                    <div class="col-md-4 col-sm-4" ng-show="TipoConsulta.Tipo != 'Todos'">
                                        <label class="control-label">
                                            {{TipoConsulta.Tipo == 'Fecha' ? 'Desde' : TipoConsulta.Tipo == 'DocNum' ? 'No. Doc.' : TipoConsulta.Tipo == 'Articulo' ? 'Código de artículo' : '' }}
                                        </label>
                                        <div id="tipoConsulta" class="overwrite-bootstrap">
                                            <a class="form-control inputstl"
                                               ng-show="TipoConsulta.Tipo == 'Fecha'"
                                               name="fechaConsulta"
                                               href="#"
                                               editable-date="ValorConsulta"
                                               buttons="yes"
                                               onaftersave="">
                                                {{ ValorConsulta | date: "dd-MM-yyyy"}}
                                            </a>

                                            <a class="form-control inputstl"
                                               ng-show="TipoConsulta.Tipo == 'DocNum'"
                                               name="fechaConsulta"
                                               href="#"
                                               buttons="yes"
                                               editable-number="ValorConsulta"
                                               onaftersave="">
                                                {{ValorConsulta}}
                                            </a>

                                            <a class="form-control inputstl"
                                               ng-show="TipoConsulta.Tipo == 'Articulo'"
                                               name="fechaConsulta"
                                               href="#"
                                               buttons="yes"
                                               editable-text="ValorConsulta"
                                               onaftersave="">
                                                {{ValorConsulta}}
                                            </a>
                                        </div>
                                    </div>

                                    <div class="col-md-4 col-sm-4">
                                        <label class="control-label" style="color: transparent;">Botón</label>
                                        <div>
                                            <button type="button" class="btn btn-default" ng-click="ConsultaPedidos();">
                                                <img src="~/Images/search1.png" />
                                                <span><strong>Buscar</strong></span>
                                            </button>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <div class="form-horizontal">
                                <div class="row">
                                    <div class="col-md-4 col-sm-4">
                                        <label class="control-label">Buscar</label>
                                        <input ng-model="QryConsultaPedido" id="search" class="form-control"
                                               placeholder="Texto de filtrado">
                                    </div>
                                    <div class="col-md-4 col-sm-4">
                                        <label class="control-label">Lineas por página</label>
                                        <input type="number" min="1" max="100" class="form-control"
                                               ng-model="QtyConsultaPedido">
                                    </div>
                                </div>
                            </div>

                            <div class="row mt-md">
                                <div class="col-lg-12 col-md-12 col-sm-12">
                                    <div class="table-responsive">
                                        <table id="tabPedidoP" class="table table-hover table-responsive">
                                            <thead>
                                                <tr>
                                                    <th>#</th>
                                                    <th class="text-center">Cliente</th>
                                                    <th class="text-center">No. Doc.</th>
                                                    <th class="text-center">Status</th>
                                                    <th class="text-center">F. pedido</th>
                                                    <th class="text-center">F. entrega</th>
                                                    <th class="text-center">F. factura</th>
                                                    <th class="text-center">No. factura</th>
                                                    <th class="text-center">Modelo</th>
                                                    <th class="text-center">Descripción</th>
                                                    <th class="text-center">Unidades medida</th>
                                                    <th class="text-center">Pedido</th>
                                                    <th ng-show="rol == 'C'" class="text-center">Num. guía</th>
                                                    <th class="text-center">Pendiente</th>
                                                    <th class="text-center">Entregado</th>
                                                    <th class="text-center">Facturado</th>
                                                    <th class="text-center">Precio</th>
                                                    <th class="text-center">Total</th>
                                                </tr>
                                            </thead>
                                            <tbody id="pedido" class="table-bordered">
                                                <tr id="eliminar" dir-paginate="pedido in ListaPedidos|orderBy:sortKey:reverse|filter:QryConsultaPedido|itemsPerPage:QtyConsultaPedido" pagination-id="queryOrders">

                                                    <td class="text-center" ng-click="AbrirModalEstadoPedido(pedido.NoPedido, 'Carlos')">{{ListaPedidos.indexOf(pedido) + 1}}</td>
                                                    <td class="text-center" ng-click="AbrirModalEstadoPedido(pedido.NoPedido, 'Carlos')">{{pedido.Cliente}}</td>
                                                    <td class="text-center" ng-click="AbrirModalEstadoPedido(pedido.NoPedido, 'Carlos')">{{pedido.NoPedido}}</td>
                                                    <td class="text-center" ng-click="AbrirModalEstadoPedido(pedido.NoPedido, 'Carlos')">{{pedido.Estado}}</td>
                                                    <td class="text-center" ng-click="AbrirModalEstadoPedido(pedido.NoPedido, 'Carlos')">{{pedido.DocDate}}</td>
                                                    <td class="text-center" ng-click="AbrirModalEstadoPedido(pedido.NoPedido, 'Carlos')">{{pedido.DocDueDate}}</td>
                                                    <td class="text-center" ng-click="AbrirModalEstadoPedido(pedido.NoPedido, 'Carlos')">{{pedido.FechaCont}}</td>
                                                    <td class="text-center" ng-click="AbrirModalEstadoPedido(pedido.NoPedido, 'Carlos')">{{pedido.DocFactura}}</td>
                                                    <td class="text-center" ng-click="AbrirModalEstadoPedido(pedido.NoPedido, 'Carlos')">{{pedido.ItemCode}}</td>
                                                    <td class="text-center" ng-click="AbrirModalEstadoPedido(pedido.NoPedido, 'Carlos')">{{pedido.ItemName}}</td>
                                                    <td class="text-center" ng-click="AbrirModalEstadoPedido(pedido.NoPedido, 'Carlos')">{{pedido.UMVendida}}</td>
                                                    <td class="text-center" ng-click="AbrirModalEstadoPedido(pedido.NoPedido, 'Carlos')">{{pedido.QtyPedida| number:0}}</td>
                                                    <td ng-show="rol == 'C'" class="text-center" ng-click="AbrirModalEstadoPedido(pedido.NoPedido, 'Carlos')">{{pedido.Guia}}</td>
                                                    <td class="text-center" ng-click="AbrirModalEstadoPedido(pedido.NoPedido, 'Carlos')">{{pedido.QtyPendiente| number:0}}</td>
                                                    <td class="text-center" ng-click="AbrirModalEstadoPedido(pedido.NoPedido, 'Carlos')">{{pedido.QtyEntregada| number:0}}</td>
                                                    <td class="text-center" ng-click="AbrirModalEstadoPedido(pedido.NoPedido, 'Carlos')">{{pedido.QtyFacturada| number:0}}</td>

                                                    <td class="text-center" ng-click="AbrirModalEstadoPedido(pedido.NoPedido, 'Carlos')">${{pedido.Precio | number:2}} MXN</td>
                                                    <td class="text-center" ng-click="AbrirModalEstadoPedido(pedido.NoPedido, 'Carlos')">${{pedido.Total | number:2 }} MXN</td>

                                                </tr>
                                            </tbody>
                                        </table>
                                    </div>
                                    <dir-pagination-controls max-size="5" direction-links="true" boundary-links="true"
                                                             pagination-id="queryOrders">
                                    </dir-pagination-controls>
                                </div>
                            </div>
                            <div growl></div>
                        </div>
                    </div>
                    <!--Fin Seccion 2-->
                </div>
            </div>

            <!-- Footer -->
            <div class="footer">
                <div class="form-horizontal" style="height:13px;">
                    <div class="form-group">
                        <div class="col-sm-12 col-md-12 col-lg-12">
                            <p>
                                <a target="_blank" href="https://api.example.com" style="color: black !important">
                                    &copy <span id="year"></span> Acme Technologies - Todos los Derechos Reservados
                                </a>
                            </p>
                        </div>
                    </div>
                </div>
            </div>
            <!-- End - Footer -->
        </div>
    </div>

    <script>
        $(document).ready(function () {
            document.getElementById("year").textContent = new Date().getFullYear();

            (function ($) {
                $.fn.inputFilter = function (inputFilter) {
                    return this.on("input keydown keyup mousedown mouseup select contextmenu drop", function () {
                        if (inputFilter(this.value)) {
                            this.oldValue = this.value;
                            this.oldSelectionStart = this.selectionStart;
                            this.oldSelectionEnd = this.selectionEnd;
                        }
                        else if (this.hasOwnProperty("oldValue")) {
                            this.value = this.oldValue;
                            this.setSelectionRange(this.oldSelectionStart, this.oldSelectionEnd);
                        }
                        else {
                            this.value = "";
                        }
                    });
                };
            }(jQuery));
        });
    </script>
</body>
</html>