<configuration>
  <configSections>
    <!-- For more information on Entity Framework configuration, visit http://go.microsoft.com/fwlink/?LinkID=237468 -->
    <section name="entityFramework" type="System.Data.Entity.Internal.ConfigFile.EntityFrameworkSection, EntityFramework, Version=6.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089" requirePermission="false"/>
  </configSections>
  <connectionStrings>
    <add name="ConexionSAPSQL" connectionString="Server=YOUR_SERVER;Database=YOUR_DATABASE;User Id=YOUR_USER;Password=YOUR_PASSWORD;" providerName="System.Data.SqlClient"/>
    <add name="ConexionSAPDI" connectionString="Server=YOUR_SERVER;Database=YOUR_DATABASE;User Id=YOUR_USER;Password=YOUR_PASSWORD;" providerName="System.Data.SqlClient"/>
    <add name="dbCRM" connectionString="Server=YOUR_SERVER;Database=YOUR_DATABASE;User Id=YOUR_USER;Password=YOUR_PASSWORD;" providerName="System.Data.SqlClient"/>
    <add name="CRMSp" connectionString="Server=YOUR_SERVER;Database=YOUR_DATABASE;User Id=YOUR_USER;Password=YOUR_PASSWORD;" providerName="System.Data.SqlClient"/>
  </connectionStrings>
  
  <appSettings>
    <add key="Server" value="YOUR_VALUE"/>
    <add key="DataBase" value="YOUR_VALUE"/>
    <add key="UserId" value="YOUR_VALUE"/>
    <add key="Password" value="YOUR_VALUE"/>
    <add key="webpages:Version" value="3.0.0.0"/>
    <add key="webpages:Enabled" value="false"/>
    <add key="ClientValidationEnabled" value="true"/>
    <add key="UnobtrusiveJavaScriptEnabled" value="true"/>
    <add key="DefaultTaxCodeBP" value="IVAT10"/>
    <add key="RptPath" value="C:\CRM\Reportes\"/>
    <add key="CodigoFormato" value="Rep33"/>
    <add key="RptPath1" value="RPT\"/>
    <add key="RutaLog" value="C:\CRM\Incidencias.txt"/>
    <add key="RutaFullLog" value="C:\CRM\Seguimiento"/>
    <add key="RutaFullImp" value="C:\CRMImp"/>
    <add key="WHS" value="PT"/>
    <add key="DataBase1" value="YOUR_VALUE"/>
    <add key="CryptoKey" value="CHANGE_ME_32_CHARACTER_KEY_HERE!"/>
  </appSettings>
  <!--
    For a description of web.config changes see http://go.microsoft.com/fwlink/?LinkId=235367.

    The following attributes can be set on the <httpRuntime> tag.
      <system.Web>
        <httpRuntime targetFramework="4.7.1" />
      </system.Web>
  -->
	
  <system.web>
    <!--<authentication mode="Forms">
      <forms loginUrl="~/Login/Index" timeout="2880" />
    </authentication>-->
    <compilation targetFramework="4.8" debug="true"/>
    <httpRuntime targetFramework="4.5.2" maxQueryStringLength="2097151" maxRequestLength="3000000" maxUrlLength="2097151"/>
    <httpModules>
      <add name="ApplicationInsightsWebTracking" type="Microsoft.ApplicationInsights.Web.ApplicationInsightsHttpModule, Microsoft.AI.Web"/>
    </httpModules>
  </system.web>
  <system.webServer>
    <modules>
      <remove name="FormsAuthentication"/>
      <!--agregado para pruebas-->
      <remove name="FormsAuthenticationModule"/>
      <!--agregado para pruebas-->
      <remove name="RoleManager"/>
      <remove name="ApplicationInsightsWebTracking"/>
      <add name="ApplicationInsightsWebTracking" type="Microsoft.ApplicationInsights.Web.ApplicationInsightsHttpModule, Microsoft.AI.Web" preCondition="managedHandler"/>
    </modules>
    <validation validateIntegratedModeConfiguration="false"/>
  </system.webServer>
  <runtime>
    <assemblyBinding xmlns="urn:schemas-microsoft-com:asm.v1">
      <dependentAssembly>
        <assemblyIdentity name="Newtonsoft.Json" culture="neutral" publicKeyToken="30ad4fe6b2a6aeed"/>
