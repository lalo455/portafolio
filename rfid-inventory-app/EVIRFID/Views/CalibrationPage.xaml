<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    xmlns="http://xamarin.com/schemas/2014/forms"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="EVIRFID.Views.CalibrationPage"
    xmlns:viewmodels="clr-namespace:EVIRFID.ViewModels"
    xmlns:models="clr-namespace:EVIRFID.Models"
    Title="{Binding Title}"
    x:DataType="viewmodels:CalibrationViewModel">

    <ContentPage.BindingContext>
        <viewmodels:CalibrationViewModel />
    </ContentPage.BindingContext>

    <ContentPage.Content>
        <Grid RowDefinitions="Auto,*,Auto" Padding="15">
            
            <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,10">
                <StackLayout Grid.Column="0" Spacing="10">
                    <Label Text="Pantalla de Pruebas RSSI" FontSize="20" FontAttributes="Bold" HorizontalOptions="Start" />
                    <StackLayout Orientation="Horizontal" HorizontalOptions="Start" Spacing="20">
                        <Label Text="{Binding CurrentRfPower, StringFormat='Potencia: {0}'}" FontSize="16" />
                        <Label Text="{Binding CurrentRfRssi, StringFormat='Umbral RSSI: {0}'}" FontSize="16" />
                    </StackLayout>
                </StackLayout>
                <Button Grid.Column="1" Text="Cerrar" Command="{Binding CloseCommand}" BackgroundColor="#E74C3C" TextColor="White" CornerRadius="8" VerticalOptions="Center" />
            </Grid>
            <BoxView Grid.Row="0" VerticalOptions="End" HeightRequest="1" Color="Gray" HorizontalOptions="FillAndExpand" Margin="0,0,0,5" />

            <ListView Grid.Row="1" ItemsSource="{Binding ListaEpcs}" HasUnevenRows="True" SelectionMode="None">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="models:CalibrationTag">
                        <ViewCell>
                            <Frame Margin="5" Padding="10" CornerRadius="8" HasShadow="True" BorderColor="LightGray">
                                <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="*,Auto">
                                    
                                    <Label Grid.Row="0" Grid.Column="0" Text="{Binding EpcHex}" FontSize="14" TextColor="Black" />
                                    <Label Grid.Row="1" Grid.Column="0" Text="{Binding TranslatedValue}" FontSize="16" FontAttributes="Bold" TextColor="DarkBlue" />
                                    
                                    <StackLayout Grid.Row="0" Grid.RowSpan="2" Grid.Column="1" VerticalOptions="Center" HorizontalOptions="End" Spacing="0">
                                        <Label Text="RSSI" FontSize="12" HorizontalOptions="Center" TextColor="Gray" />
                                        <Label Text="{Binding RssiValue}" FontSize="24" FontAttributes="Bold" HorizontalOptions="Center">
                                            <Label.Triggers>
                                                <DataTrigger TargetType="Label" Binding="{Binding IsInRange}" Value="True">
                                                    <Setter Property="TextColor" Value="DarkGreen" />
                                                </DataTrigger>
                                                <DataTrigger TargetType="Label" Binding="{Binding IsInRange}" Value="False">
                                                    <Setter Property="TextColor" Value="Red" />
                                                </DataTrigger>
                                            </Label.Triggers>
                                        </Label>
                                    </StackLayout>
                                </Grid>
                            </Frame>
                        </ViewCell>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <StackLayout Grid.Row="2" Orientation="Horizontal" Spacing="15" Margin="0,10,0,0">
                <Button Text="Limpiar" Command="{Binding ClearListCommand}" BackgroundColor="#E0E0E0" TextColor="Black" CornerRadius="8" HorizontalOptions="FillAndExpand" />
                <Button Command="{Binding ScanCommand}" BackgroundColor="#2E86DE" TextColor="White" CornerRadius="8" HorizontalOptions="FillAndExpand">
                    <Button.Triggers>
                        <DataTrigger TargetType="Button" Binding="{Binding IsScanning}" Value="True">
                            <Setter Property="Text" Value="Detener" />
                            <Setter Property="BackgroundColor" Value="Red" />
                        </DataTrigger>
                        <DataTrigger TargetType="Button" Binding="{Binding IsScanning}" Value="False">
                            <Setter Property="Text" Value="Leer" />
                        </DataTrigger>
                    </Button.Triggers>
                </Button>
            </StackLayout>
        </Grid>
    </ContentPage.Content>
</ContentPage>
