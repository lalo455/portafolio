<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    xmlns="http://xamarin.com/schemas/2014/forms"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="EVIRFID.Views.PersonsPage"
    Title="{Binding Title}"
    xmlns:local="clr-namespace:EVIRFID.ViewModels"
    xmlns:model="clr-namespace:EVIRFID.Models"
    xmlns:xct="http://xamarin.com/schemas/2020/toolkit"
    xmlns:viewmodels="clr-namespace:EVIRFID.ViewModels"
    xmlns:dxcv="http://schemas.devexpress.com/xamarin/2014/forms/collectionview"
    xmlns:dxe="http://schemas.devexpress.com/xamarin/2014/forms/editors"
    x:Name="BrowsePersonsPage"
    x:DataType="viewmodels:PersonsViewModel">

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Alta Elem" Command="{Binding NuevoElementoCommand}" />
        <ToolbarItem Text="Asignar ítems" Command="{Binding AddTagsToPersonCommand}" />
    </ContentPage.ToolbarItems>

    <ContentPage.BindingContext>
        <local:PersonsViewModel/>
    </ContentPage.BindingContext>

    <ContentPage.Content>
        <StackLayout>
            <StackLayout Orientation="Horizontal">
                <dxe:TextEdit LabelText="Nombre a buscar" HorizontalOptions="FillAndExpand" Text="{Binding Filtro, Mode=TwoWay}" Keyboard="Text" Completed="TextEdit_Completed"></dxe:TextEdit>
                <dxe:SimpleButton Text="Filtrar"
                              BorderThickness="2"
                              BorderColor="Black"
                              PressedBorderColor="DarkOrange"
                              DisabledBorderColor="DarkGray"
                              TextColor="Black"
                              PressedTextColor="White"
                              DisabledTextColor="DarkGray"
                              IconColor="Black"
                              PressedIconColor="White"
                              DisabledIconColor="DarkGray"
                              BackgroundColor="Beige"
                              DisabledBackgroundColor="Brown"
                              PressedBackgroundColor="Gray"
                              CornerMode = "Round"        
                              CornerRadius="10"
                              Command="{Binding LoadFilteredPersonsCommand}"/>
            </StackLayout>
            <dxcv:DXCollectionView ItemsSource="{Binding Personas}"
                                   IsPullToRefreshEnabled="True"
                                   PullToRefreshCommand="{Binding LoadPersonsCommand}"
                                   IsRefreshing="{Binding IsBusy, Mode=TwoWay}"
                                   SelectionMode="Single"
                                   SelectedItem="{Binding SelectedPerson, Mode=TwoWay}">
                <dxcv:DXCollectionView.ItemTemplate>
                    <DataTemplate x:DataType="model:Person">
                        <Grid Padding="10, 8, 18, 7">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="50"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <xct:AvatarView Grid.Column="0" Text="{Binding iniciales}"></xct:AvatarView>
                            <StackLayout Grid.Column="1"
                             Padding="18,1,18,7"
                             Orientation="Vertical">
                                <Label Text="{Binding cuip}" TextColor="Blue" FontSize="Small" Style="{StaticResource SecondaryLabel}"></Label>
                                <Label Text="{Binding nombre}" Margin="0,2,0,0" TextColor="#55575c" FontAttributes="Bold" Style="{StaticResource SecondaryLabel}"/>
                                <StackLayout Orientation="Horizontal">
                                    <Label Text="{Binding adscripcion}" TextColor="#959aa0" FontSize="Small" Style="{StaticResource SecondaryLabel}"/>
                                </StackLayout>
                            </StackLayout>
                        </Grid>
                    </DataTemplate>
                </dxcv:DXCollectionView.ItemTemplate>
                <dxcv:DXCollectionView.SelectedItemTemplate>
                    <DataTemplate x:DataType="model:Person">
                        <Grid Padding="10, 8, 18, 7" BackgroundColor="LightGreen">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="50"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="50"/>
                            </Grid.ColumnDefinitions>
                            <xct:AvatarView Grid.Column="0" Text="{Binding iniciales}"></xct:AvatarView>
                            <StackLayout Grid.Column="1" Padding="18,1,18,7" Orientation="Vertical">
                                <Label Text="{Binding cuip}" TextColor="Blue" FontSize="Small" Style="{StaticResource SecondaryLabel}"></Label>
                                <Label Text="{Binding nombre}" Margin="0,2" TextColor="#55575c" FontAttributes="Bold" Style="{StaticResource SecondaryLabel}"/>
                                <Label Text="{Binding adscripcion}" TextColor="#959aa0" Style="{StaticResource SecondaryLabel}"/>
                            </StackLayout>
                            <StackLayout Grid.Column="2">
                                <Label Text="Items:"  Style="{StaticResource SecondaryLabel}"></Label>
                                <Label Text="{Binding itemsAsignados}"  FontSize="Subtitle" HorizontalTextAlignment="End" Style="{StaticResource SecondaryLabel}"></Label>
                            </StackLayout>
                        </Grid>
                    </DataTemplate>
                </dxcv:DXCollectionView.SelectedItemTemplate>
                <dxcv:DXCollectionView.GroupDescription>
                    <dxcv:GroupDescription FieldName="nombre" GroupInterval="Alphabetical"/>
                </dxcv:DXCollectionView.GroupDescription>
                <dxcv:DXCollectionView.GroupHeaderTemplate>
                    <DataTemplate x:DataType="dxcv:GroupInfo">
                        <StackLayout>
                            <Label Text="{Binding Value}" FontAttributes="Bold" TextColor="Black" Style="{StaticResource SecondaryLabel}"></Label>
                            <BoxView BackgroundColor="WhiteSmoke" HeightRequest="1"></BoxView>
                        </StackLayout>
                    </DataTemplate>
                </dxcv:DXCollectionView.GroupHeaderTemplate>
                <!--Specify margins.-->
                <dxcv:DXCollectionView.Margin>
                    <OnIdiom x:TypeArguments="Thickness" Phone="10,0,10,0" Tablet="71,0,0,0"/>
                </dxcv:DXCollectionView.Margin>
            </dxcv:DXCollectionView>
        </StackLayout>
    </ContentPage.Content>
</ContentPage>