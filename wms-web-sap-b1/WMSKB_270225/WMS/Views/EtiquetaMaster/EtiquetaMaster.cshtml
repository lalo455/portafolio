@{
    Layout = null;
}
<!DOCTYPE html>
<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <meta name="viewport" content="width=device-width" />
    <link href="~/Library/Bootstrap/css/bootstrap.css" rel="stylesheet" />
    <link href="~/Library/Estilos/Styles.css" rel="stylesheet" />
    <link href="~/Library/Growl/angular-growl.min.css" rel="stylesheet" />
    <link href="~/Library/XEditable/xeditable.css" rel="stylesheet" />
    <link href="~/Library/FontAwesome/fontawesome/css/fontawesome.min.css" rel="stylesheet" />
    <link href="~/Library/FontAwesome/fontawesome/css/solid.css" rel="stylesheet" />
    <link href="~/Library/Messi/messi.min.css" rel="stylesheet" />

    <title>Etiqueta Master</title>
</head>
<body ng-app="etqMasterApp" ng-controller="etqMasterController" class="animated fadeIn fast">
    <div growl></div>
    <nav class="navbar navbar-expand-lg navbar-light bg-light">
        <a class="navbar-brand" href="#">
            <img src="~/Assets/EtqMaster.png" width="30" height="30" class="d-inline-block align-top" alt=""> Etiqueta Master
        </a>
        <button onclick="location.href='@Url.Action("Menu", "Menu")'" class="navbar-toggler" type="button" data-toggle="collapse" data-target="#navbarSupportedContent" aria-controls="navbarSupportedContent" aria-expanded="false" aria-label="Toggle navigation">
            <img src="~/Assets/back.png" />
        </button>
        <div class="collapse navbar-collapse" id="navbarSupportedContent">
            <ul class="navbar-nav mr-auto"></ul>
            <form class="form-inline my-2 my-lg-0">
                <button onclick="location.href='@Url.Action("Menu", "Menu")'" class="btn btn-light my-2 my-sm-0" type="submit">
                    <img src="~/Assets/back.png" />
                </button>
            </form>
        </div>
    </nav>

    <div class="container pt-3">
        <div class="form-group row">
            <label for="Clientes" class="col-3 col-sm-3 col-md-3 col-lg-1 col-xl-1 form-label py-0 pr-0 mt-2">Acción</label>
            <div class="col-7 col-sm-6 col-md-5 col-lg-4 col-xl-3">
                <select ng-model="Lectura.Base" class="form-control custom-select"
                        ng-model-options="{getterSetter:true}"
                        ng-options="D.Tipo as D.Accion for D in Lectura.AccBase"
                        ng-change="CambiarAccion(Lectura.Base)"
                        ng-disabled="Memoria.Existe == 'no'">

                    <option style="display:none" value="">Seleccione Accion...</option>
                </select>
            </div>
        </div>

        <div class="form-group row" ng-show="Lectura.Base == 'adminM'">
            <label for="EtqMaster" class="col-3 col-sm-3 col-md-3 col-lg-1 col-xl-1 form-label py-0 pr-0 mt-2">Etq. Master</label>
            <div class="col-7 col-sm-6 col-md-5 col-lg-4 col-xl-3">
                <div class="input-group">
                    <input id="EtMt" 
                           class="form-control" 
                           placeholder="Etq. Master" 
                           type="text" 
                           ng-model="Memoria.Master" 
                           ng-disabled="Memoria.MasterCargada == 'Y'"/>

                    <div class="input-group-append">
                        <button class="btn btn-outline-secondary" 
                                type="button" 
                                ng-click="CargarEtMaster()" 
                                ng-disabled="Memoria.Procesando">
                        <i class="fas fa-plus"></i>
                        </button>
                        
                        <button class="btn btn-outline-secondary" 
                                type="button" 
                                ng-click="ListarMaster()" 
                                ng-disabled="Memoria.Procesando">
                        <i class="fas fa-list"></i>
                        </button>
                    </div>
                </div>
            </div>
        </div>

        <div class="form-group row">
            <div class="col-6 col-sm-6 col-md-4 col-lg-3 col-xl-3 mr-0">
                <input id="Entradas" 
                       class="form-control" 
                       placeholder="Etiqueta" 
                       type="text" 
                       ng-model="Lectura.Etiqueta" 
                       ng-change="LecturaQR()"
                       ng-disabled="Memoria.Existe == 'no' || (Lectura.Base == 'adminM' && Memoria.MasterCargada == 'N')"/>
            </div>
            <h3 style="color:red">{{Etiquetas.Lineas.length}}</h3>
        </div>
    </div>

    <div class="container">
        <div class="row">
            <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12 col-lg-offset-0" style="padding:0em;">
                <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12 " style="padding:0em; padding-left:1em; margin-top:7px;">
                    <div class="megaTras">
                        <table class='headerTras'>
                            <tr>
                                <td class="colTH6">#</td>
                                <td class="colTH2">Lote</td>
                                <td class="colTH3">Artículo</td>
                                <td class="colTH5">Cantidad</td>

                                <td class="colTH3">Master</td>
                                @*<td class="colTH3" ng-show="Lectura.Base == 'adminM'">Nueva Master</td>*@
                                <td class="colTH5" ng-show="Lectura.Base == 'adminM'">Eliminar</td>
                                <td class="colTH5" ng-show="Lectura.Base == 'crearM'">Remover</td>
                            </tr>
                        </table>
                        <table style="width:100%; margin-top:40px;">
                            <tbody>
                                <tr ng-repeat="Ln in Etiquetas.Lineas">
                                    <td class="colTT6">{{$index + 1}}</td>
                                    <td class="colTT2">{{Ln.DistNumber}}</td>
                                    <td class="colTT3">{{Ln.ItemCode}}</td>
                                    <td class="colTT5">{{Ln.OnHandQty}}</td>

                                    <td class="colTT3">{{Ln.EtqMaster}}</td>
                                    @*<td class="colTT3" ng-show="Lectura.Base == 'adminM'">{{Ln.NewEtqMaster}}</td>*@
                                    <td class="colTT5" ng-show="Lectura.Base == 'adminM'"><img src="~/Assets/delete.png" ng-click="Eliminar($index)" /></td>
                                    <td class="colTT5" ng-show="Lectura.Base == 'crearM'"><img src="~/Assets/delete.png" ng-click="Eliminar($index)" /></td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="container">
        <div class="row pb-4 mt-4">
            <div class="col-12 col-lg-12 col-md-12 col-sm-12 text-center">
                <button ng-hide="Memoria.Procesando"
                        type="button"
                        class="btn btn-lg btn-warning"
                        ng-click="GenerarMovimiento()"
                        ng-disabled="Etiquetas.Lineas.length == 0 || Memoria.Procesando">
                    <span>Imprimir Master</span>
                </button>

                <img class="col-12 col-lg-3 col-md-4 col-sm-12" style="width: 22%;" ng-show="Memoria.Procesando" src="~/Assets/loading_.gif" />
            </div>
        </div>
    </div>

    <script src="~/Library/JQuery/jquery-3.3.1.js"></script>
    <script src="~/Library/Angular/angular.min.js"></script>
    <script src="~/Library/Growl/angular-growl.min.js"></script>
    <script src="~/Library/Bootstrap/js/ui-bootstrap-tpls.min.js"></script>
    <script src="~/Library/XEditable/xeditable.min.js"></script>
    <script src="~/Library/Messi/messi.min.js"></script>
    <script src="~/Scripts/decimal.js"></script>
    <script src="~/Scripts/EtqMaster/EtiquetaMaster.js"></script>

</body>
</html>
