<!DOCTYPE html>
<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>Calidad</title>
    <meta name="viewport" content="width=device-width" />
    <link href="~/Library/Bootstrap/css/bootstrap.css" rel="stylesheet" />
    <link href="~/Library/Estilos/Styles.css" rel="stylesheet" />
    <link href="~/Library/Growl/angular-growl.min.css" rel="stylesheet" />
    <link href="~/Library/FontAwesome/fontawesome/css/fontawesome.min.css" rel="stylesheet" />
    <link href="~/Library/FontAwesome/fontawesome/css/solid.css" rel="stylesheet" />
</head>
<body ng-app="calidadApp" ng-controller="calidadController" class="animated fadeIn fast">
    <div growl></div>
    <nav class="navbar navbar-expand-lg navbar-light bg-light">
        <a class="navbar-brand" href="#">
            <img src="~/Assets/Calidad.png" width="30" height="30" class="d-inline-block align-top" alt=""> Calidad
        </a>
        <button onclick="location.href='@Url.Action("Menu", "Menu")'" class="navbar-toggler" type="button" data-toggle="collapse" data-target="#navbarSupportedContent" aria-controls="navbarSupportedContent" aria-expanded="false" aria-label="Toggle navigation">
            <img src="~/Assets/back.png" />
        </button>
        <div class="collapse navbar-collapse" id="navbarSupportedContent">
            <ul class="navbar-nav mr-auto"></ul>
            <form class="form-inline my-2 my-lg-0">
                <button onclick="location.href='@Url.Action("Menu", "Menu")'" class="btn btn-light my-2 my-sm-0" type="submit">
                    <img src="~/Assets/back.png" />
                </button>
            </form>
        </div>
    </nav>

    <div class="container pt-3">
        <div class="form-group row">
            @* X: Bloqueo | O: Desbloqueo *@
            <label for="Cliente" class="col-3 col-sm-3 col-md-3 col-lg-1 col-xl-1 col-form-label pr-0">Actualizar a </label>
            <div class="col-6 col-sm-6 col-md-5 col-lg-4 col-xl-3">
                <select ng-model="Calidad.Estatus" class="form-control custom-select"
                        ng-model-options="{getterSetter:true}"
                        ng-change="limpiarLineas()"
                        ng-options="Cl.Code as Cl.Name for Cl in Calidad.Acciones">
                    <option style="display:none" value="">Seleccione un valor</option>
                </select>
            </div>
        </div>

        <div class="form-group row" ng-show="Calidad.Estatus == 'O' || Calidad.Estatus == 'X'">
            <label for="Almacen" class="col-3 col-sm-3 col-md-3 col-lg-1 col-xl-1 form-label pr-0">Almacén Origen</label>
            <div class="col-6 col-sm-6 col-md-5 col-lg-4 col-xl-3">
                <select ng-model="Calidad.AlmacenOSel" class="form-control custom-select"
                        ng-model-options="{getterSetter:true}"
                        ng-disabled="Calidad.FromWhsCodes.length == 0"
                        ng-options="Alm.WhsCode as Alm.WhsCode +'-'+Alm.WhsName for Alm in Calidad.FromWhsCodes">
                    <option style="display:none" value="">Seleccione Almacén</option>
                </select>
            </div>
        </div>

        <!--Se agrega opcion para indicar si se realiza traspaso | esto cuando es bloqueo o desbloqueo-->
        <div class="form-group row" ng-show="(Calidad.Estatus == 'X' || Calidad.Estatus == 'O')">
            <label for="Cliente" class="col-3 col-sm-3 col-md-3 col-lg-1 col-xl-1 col-form-label pr-0">Traspaso</label>
            <div class="col-6 col-sm-6 col-md-5 col-lg-4 col-xl-3">
                <select ng-model="Calidad.Traspaso" class="form-control custom-select"
                        ng-model-options="{getterSetter:true}"
                        ng-change="TraspasoLt()"
                        ng-options="Cl.Code as Cl.Name for Cl in Calidad.MoverLote">
                    <option style="display:none" value="">Seleccione un valor</option>
                </select>
            </div>
        </div>
        <!--***********************************************************************************************-->
        <!--Se agrega opcion para indicar si se realiza BLOQUEO o solo Traspaso | esto cuando es bloqueo-->
        <div class="form-group row" ng-show="(Calidad.Estatus == 'X')">
            <label for="Cliente" class="col-3 col-sm-3 col-md-3 col-lg-1 col-xl-1 col-form-label pr-0">Bloqueo</label>
            <div class="col-6 col-sm-6 col-md-5 col-lg-4 col-xl-3">
                <select ng-model="Calidad.Bloquear" class="form-control custom-select"
                        ng-model-options="{getterSetter:true}"
                        ng-options="Cl.Code as Cl.Name for Cl in Calidad.TrBloqueo">
                    <option style="display:none" value="">Seleccione un valor</option>
                </select>
            </div>
        </div>
        <!--***********************************************************************************************-->
        <!--***********************************************************************************************-->
        <div class="form-group row" ng-show="(Calidad.Estatus == 'X' || Calidad.Estatus == 'O') && (Calidad.Traspaso == 'Y')">
            <label for="Almacen" class="col-3 col-sm-3 col-md-3 col-lg-1 col-xl-1 form-label pr-0">Almacén Destino</label>
            <div class="col-6 col-sm-6 col-md-5 col-lg-4 col-xl-3">
                <select disabled ng-model="Calidad.AlmacenDSel" class="form-control custom-select"
                        ng-model-options="{getterSetter:true}"
                        ng-disabled="Calidad.ToWhsCodes.length == 0 || Calidad.Estatus == 'X'"
                        ng-options="Alm.WhsCode as Alm.WhsCode +'-'+Alm.WhsName for Alm in Calidad.ToWhsCodes">
                    <option style="display:none" value="">Seleccione Almacén</option>
                </select>
            </div>
        </div>
        <!--***********************************************************************************************-->

    </div>

    <div class="container">
        <div class="form-group row">
            <div class="col-6 col-sm-6 col-md-4 col-lg-3 col-xl-3 mr-0">
                <input id="Entradas"
                       class="form-control"
                       placeholder="Etiqueta"
                       ng-disabled="(!Calidad.Estatus) 
                                    || (Calidad.Traspaso =='Y' && (!Calidad.AlmacenOSel || !Calidad.AlmacenDSel))
                                    || (Calidad.Traspaso =='N' && (!Calidad.AlmacenOSel))"
                       type="text"
                       ng-model="Lectura.Etiqueta"
                       ng-change="LecturaQR()" />
            </div>
            <h3 style="color:red">{{Calidad.Lineas.length}}</h3>
        </div>
    </div>

    <div class="container">
        <div class="row">
            <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12 col-lg-offset-0" style="padding:0em;">
                <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12 " style="padding:0em; padding-left:1em; margin-top:7px;">
                    <div class="megaTras">
                        <table class='headerTras'>
                            <tr>
                                <td class="colTH6">#</td>
                                <td class="colTH2">Lote</td>
                                <td class="colTH3">Artículo</td>
                                @*<td class="colTH5">Alm. Origen</td>
                                <td class="colTH2">Ub. Origen</td>*@
                                @*<td class="colTH2" ng-show="Calidad.Traspaso == 'Y'">Ub. Destino</td>*@
                                <td class="colTH5"><span style="font-size:2em"><i class="fas fa-tags"></i></span></td>
                                <td class="colTH5">Cantidad</td>
                                <td class="colTH5">Accion</td>
                            </tr>
                        </table>
                        <table style="width:100%; margin-top:45px;">
                            <tbody>
                                <tr ng-repeat="Ln in Calidad.Lineas">
                                    <td class="colTT6">{{$index + 1}}</td>
                                    <td class="colTT2">{{Ln.DistNumber}}</td>
                                    <td class="colTT3">{{Ln.ItemCode}}</td>
                                    @*<td class="colTT5">{{Ln.WhsCode}}</td>
                                    <td class="colTT2">{{Ln.BinCode}}</td>*@
                                    @*<td class="colTT2" ng-show="Calidad.Traspaso == 'Y'">{{Ln.NewBinCode || 'Sin asignar'}}</td>*@
                                    <td class="colTT5">{{Ln.Etqs}}</td>
                                    <td class="colTT5">{{Ln.OnHandQty}}</td>
                                    <td class="colTT5"><img src="~/Assets/delete.png" ng-click="Eliminar($index)" /></td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="container">
        <div class="row pb-4 mt-4">
            <div class="col-12 col-lg-12 col-md-12 col-sm-12 text-center">
                <button ng-hide="Lectura.Procesando" type="button" class="btn btn-lg btn-warning" id="" ng-click="Actualizar()" ng-disabled="Calidad.Lineas.length == 0 || Calidad.Procesando">Actualizar</button>
                <img class="col-12 col-lg-3 col-md-4 col-sm-12" style="width: 22%;" ng-show="Lectura.Procesando" src="~/Assets/loading_.gif" />
            </div>
        </div>
    </div>

    <script src="~/Library/JQuery/jquery-3.3.1.js" asp-append-version="true"></script>
    <script src="~/Scripts/Funciones.js" asp-append-version="true"></script>
    <script src="~/Scripts/decimal.js" asp-append-version="true"></script>
    <script src="~/Library/Angular/angular.min.js" asp-append-version="true"></script>
    <script src="~/Library/Growl/angular-growl.min.js" asp-append-version="true"></script>
    <script src="~/Library/Bootstrap/js/ui-bootstrap-tpls.min.js" asp-append-version="true"></script>
    <script src="~/Scripts/Calidad/Calidad.js" asp-append-version="true"></script>

</body>
</html>
