<!DOCTYPE html>

<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <link href="~/Library/Bootstrap/css/bootstrap.css" rel="stylesheet" />
    <link href="~/Library/Growl/angular-growl.min.css" rel="stylesheet" />
    <link href="~/Library/XEditable/xeditable.css" rel="stylesheet" />
    <link href="~/Library/Estilos/Styles.css" rel="stylesheet" />
    <link href="~/Library/JQuery/jquery-ui.css" rel="stylesheet" />
    <link href="~/Library/FontAwesome/fontawesome/css/fontawesome.min.css" rel="stylesheet" />
    <link href="~/Library/FontAwesome/fontawesome/css/solid.css" rel="stylesheet" />
    <title>Recuento de Inventario</title>
</head>
<body ng-app="recuentoApp" ng-controller="reciboProdController" class="animated fadeIn fast">
    <div growl></div>
    <nav class="navbar navbar-expand-lg navbar-light bg-light">
        <a class="navbar-brand" href="#">
            <img src="~/Assets/Recuento_Inv.png" width="30" height="30" class="d-inline-block align-top" alt=""> Recuento de Inventario
        </a>
        <button onclick="location.href='@Url.Action("Menu", "Menu")'" class="navbar-toggler" type="button" data-toggle="collapse" data-target="#navbarSupportedContent" aria-controls="navbarSupportedContent" aria-expanded="false" aria-label="Toggle navigation">
            <img src="~/Assets/back.png" />
        </button>
        <div class="collapse navbar-collapse" id="navbarSupportedContent">
            <ul class="navbar-nav mr-auto"></ul>
            <form class="form-inline my-2 my-lg-0">
                <button onclick="location.href='@Url.Action("Menu", "Menu")'" class="btn btn-light my-2 my-sm-0" type="submit">
                    <img src="~/Assets/back.png" />
                </button>
            </form>
        </div>
    </nav>

    <div class="container pt-3">
        <div class="form-group row">
            <label for="Clientes" class="col-4 col-sm-4 col-md-4 col-lg-2 col-xl-2 form-label py-0 pr-0 mt-2">No Recuento</label>
            <div class="col-3 col-sm-2 col-md-2 col-lg-2 col-xl-1">
                <select ng-model="Recuento.Num" class="form-control custom-select"
                        ng-model-options="{getterSetter:true}"
                        ng-options="R.Num as R.Num for R in Recuento.Numeros">
                    <option style="display:none" value="">Num. Recuento</option>
                </select>
            </div>
        </div>

        <div class="form-group row">
            <label for="Almacen" class="col-4 col-sm-4 col-md-4 col-lg-2 col-xl-2 form-label py-0 pr-0 mt-2">Almacén</label>
            <div class="col-7 col-sm-6 col-md-5 col-lg-4 col-xl-3">
                <select ng-model="Recuento.AlmacenSel" class="form-control custom-select"
                        ng-model-options="{getterSetter:true}"
                        ng-options="Alm.WhsCode as Alm.WhsCode +'-'+Alm.WhsName for Alm in Recuento.Almacenes"
                        ng-change="AsignarAlms('S')"
                        ng-disabled="Recuento.Lineas.length > 0">
                    <option style="display:none" value="">Seleccione Almacén</option>
                </select>
            </div>
        </div>

        <div class="form-group row">
            <label for="ListaUbi" class="col-4 col-sm-4 col-md-4 col-lg-2 col-xl-2 form-label py-0 pr-0 mt-2">Ubicación</label>
            <div class="col-7 col-sm-6 col-md-5 col-lg-4 col-xl-3">
                <div class="input-group">
                    <input type="text"
                           class="form-control"
                           placeholder="Ubicación"
                           ng-model="Memoria.BinCode"
                           ng-disabled="!Recuento.AlmacenSel">
                    <div class="input-group-append">
                        <button class="btn btn-outline-secondary"
                                type="button"
                                ng-click="ListarUbicaciones('S')"
                                ng-disabled="!Recuento.AlmacenSel">
                            <i class="fas fa-list"></i>
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="container">
        <div class="form-group row">
            <div class="col-4 col-sm-4 col-md-4 col-lg-4 col-xl-4">
                <input id="Entradas"
                       class="form-control"
                       placeholder="Etiqueta"
                       type="text"
                       ng-model="Lectura.Etiqueta"
                       ng-change="LecturaQR()" 
                       ng-disabled="!Recuento.AlmacenSel"/>
            </div>

            <div class="col-4 col-sm-4 col-md-4 col-lg-4 col-xl-4">
                <h3 style="color:red">{{Recuento.Lineas.length}}</h3>
            </div>
        </div>
    </div>

    <div class="container">
        <div class="row">
            <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12 col-lg-offset-0" style="padding:0em;">
                <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12" style="padding:0em; padding-left:1em; margin-top:7px;">
                    <div class="megaTras">
                        <table class='headerTras'>
                            <tr>
                                <td class="colTH6">#</td>
                                <td class="colTH2">Lote</td>
                                <td class="colTH3">Artículo</td>
                                @*<td class="colTH3">Ctd. SAP</td>*@
                                <td class="colTH5">Ctd. Ctda</td>
                                <td class="colTH3">Ubicación</td>
                                <td class="colTH5">Accion</td>
                            </tr>
                        </table>
                        <table style="width:100%; margin-top:40px;">
                            <tbody>
                                <tr ng-repeat="Ln in Recuento.Lineas">
                                    <td class="colTT6">{{$index + 1}}</td>
                                    <td class="colTT2">{{Ln.DistNumber}}</td>
                                    <td class="colTT3">{{Ln.ItemCode}}</td>
                                    @*<td class="colTT3">{{Ln.OnHandQty}}</td>*@
                                    
                                    <td class="colTT5">
                                        <div class="popover-wrapper">
                                            <a href="#"
                                               editable-text="Ln.Ctd_Ctda"
                                               e-required
                                               e-placeholder="Ingrese cantidad"
                                               editable-number="Ln.Ctd_Ctda"
                                               e-min="1">
                                                {{Ln.Ctd_Ctda || '0'}}
                                            </a>
                                        </div>
                                    </td>
                                    
                                    <td class="colTT3"
                                        style="cursor: pointer; color: cornflowerblue;"
                                        ng-click="ConfirmarUbicacion($index)">
                                        <u>{{Ln.BinCode || 'Ub. Sistema'}}</u>
                                    </td>

                                    <td class="colTT5"><img src="~/Assets/delete.png" ng-click="Eliminar($index)" /></td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="container">
        <div class="row pb-4 mt-4">
            <div class="col-12 col-lg-12 col-md-12 col-sm-12 text-center">
                <button ng-hide="Lectura.Movimiento" 
                        type="button" 
                        class="btn btn-lg btn-warning" 
                        style="background-color:#DAA520" 
                        ng-click="Documento()" 
                        ng-disabled="Recuento.Lineas.length == 0 || Recuento.AlmacenSel == '' || Lectura.Movimiento">Generar Movimiento</button>
                <img class="col-12 col-lg-3 col-md-4 col-sm-12" style="width: 22%;" ng-show="Lectura.Movimiento" src="~/Assets/loading_.gif" />
            </div>
        </div>
    </div>

    <script src="~/Library/JQuery/jquery-3.3.1.js" asp-append-version="true"></script>
    <script src="~/Library/Angular/angular.min.js" asp-append-version="true"></script>
    <script src="~/Library/Growl/angular-growl.min.js" asp-append-version="true"></script>
    <script src="~/Library/Bootstrap/js/ui-bootstrap-tpls.min.js" asp-append-version="true"></script>
    <script src="~/Library/XEditable/xeditable.min.js" asp-append-version="true"></script>
    <script src="~/Scripts/decimal.js" asp-append-version="true"></script>
    <script src="~/Scripts/Recuento/RecuentoInv.js" asp-append-version="true"></script>

</body>
</html>
